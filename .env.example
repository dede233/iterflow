# Docker Compose bootstrap only; the API does not read this variable.
POSTGRES_PASSWORD=

# IterFlow API
# Docker example: postgresql+psycopg://iterflow:<your-password>@db:5432/iterflow
DATABASE_URL=

# Redis
REDIS_URL=redis://redis:6379/0

# JWT: generate a long random value for every environment.
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# Object storage. LocalFileStorage is the development default.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/uploads

# Optional S3 Compatible Object Storage (used when STORAGE_DRIVER=s3).
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=iterflow
S3_REGION=us-east-1

# Initial administrator. The seed command refuses to create an administrator
# when either value is empty.
INIT_ADMIN_USERNAME=
INIT_ADMIN_PASSWORD=
