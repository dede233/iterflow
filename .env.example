# Docker Compose bootstrap only; the API does not read this variable.
POSTGRES_PASSWORD=

# IterFlow API
# Docker example: postgresql+psycopg://iterflow:<your-password>@db:5432/iterflow
DATABASE_URL=

# Redis
REDIS_URL=redis://redis:6379/0

# JWT: generate a long random value for every environment.
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
APP_ENV=production
# Same-origin production deployment may leave this empty. Never use *.
CORS_ORIGINS=
# Public Web host only; the API healthcheck connects through loopback while
# sending an allowed Host header. Do not add localhost solely for probes.
ALLOWED_HOSTS=iterflow.example.com
TRUST_PROXY_HEADERS=true
LOG_LEVEL=INFO
ENABLE_API_DOCS=false
BUILD_SHA=unknown
WEB_BIND_HOST=127.0.0.1

# Object storage. LocalFileStorage is the development default.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/uploads

# Optional S3 Compatible Object Storage (used when STORAGE_DRIVER=s3).
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=iterflow
S3_REGION=us-east-1

# First startup requires an 8-128 character bootstrap password (20+ random
# characters recommended). After creation it may be cleared; seed never resets
# an existing administrator's password.
INIT_ADMIN_USERNAME=
INIT_ADMIN_PASSWORD=
