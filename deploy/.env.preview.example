# Copy to deploy/.env.preview, chmod 600, and fill all blank secrets on the Docker host.
COMPOSE_PROJECT_NAME=iterflow-preview
CONTAINER_PREFIX=iterflow-preview
POSTGRES_PORT=55432
REDIS_PORT=56379
API_PORT=18000
WEB_PORT=18080
WEB_BIND_HOST=127.0.0.1
APP_ENV=production
ALLOWED_HOSTS=iterflow.luqingyao.cc.cd
CORS_ORIGINS=
TRUST_PROXY_HEADERS=true
ENABLE_API_DOCS=false
STORAGE_DRIVER=local
INIT_ADMIN_USERNAME=admin
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=
INIT_ADMIN_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=
