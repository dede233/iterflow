[Unit]
Description=IterFlow retained isolated test stack
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/iterflow/acceptance/iterflow-acceptance-20261012-753ebd
ExecStart=/usr/bin/python3 /opt/iterflow/acceptance/iterflow-acceptance-20261012-753ebd/autorecovery.py start-stack
ExecStop=/usr/bin/python3 /opt/iterflow/acceptance/iterflow-acceptance-20261012-753ebd/autorecovery.py stop-stack
TimeoutStartSec=360
TimeoutStopSec=150
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
