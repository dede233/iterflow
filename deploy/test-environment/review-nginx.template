worker_processes 1;
pid @@STAGE@@/review.pid;
error_log @@STAGE@@/review-error.log warn;
events { worker_connections 128; }
http {
    lua_package_path "/www/server/nginx/lib/lua/?.lua;;";
    access_log off;
    server {
        listen 8444 ssl;
        server_name sx-kc.xyz;
        ssl_certificate /www/server/panel/vhost/cert/sx-kc.xyz/fullchain.pem;
        ssl_certificate_key /www/server/panel/vhost/cert/sx-kc.xyz/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 20m;
        location / {
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_pass http://@@WEB_IP@@:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
    }
}
