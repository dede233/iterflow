{
  "name": "iterflow-web",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "generate:api-types": "openapi-typescript ../spec/openapi-v1.5.yaml -o src/types/openapi.generated.ts",
    "check:api-types": "node scripts/check-api-types.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^13.0.0",
    "axios": "^1.8.0",
    "element-plus": "^2.9.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
